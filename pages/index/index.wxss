.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
}

.title {
  font-size: 72rpx;
  font-weight: bold;
  color: #8B4513;
  margin-bottom: 20rpx;
  text-shadow: 2rpx 2rpx 4rpx rgba(0,0,0,0.1);
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 80rpx;
}

.menu {
  width: 100%;
  max-width: 600rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 40rpx;
  margin-bottom: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  transition: transform 0.2s;
}

.menu-item:active {
  transform: scale(0.98);
  background: #f9f9f9;
}

.icon {
  font-size: 48rpx;
  margin-right: 30rpx;
}

.label {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.rules {
  margin-top: 60rpx;
  padding: 40rpx;
  background: rgba(139, 69, 19, 0.05);
  border-radius: 16rpx;
  width: 100%;
  max-width: 600rpx;
}

.rules-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B4513;
  margin-bottom: 20rpx;
  text-align: center;
}

.rules-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}