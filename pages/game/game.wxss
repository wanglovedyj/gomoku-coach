.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

/* 游戏信息 */
.game-info {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  padding: 20rpx 40rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.player {
  display: flex;
  align-items: center;
  padding: 10rpx 30rpx;
  border-radius: 10rpx;
  opacity: 0.5;
  transition: opacity 0.3s;
}

.player.active {
  opacity: 1;
  background: rgba(139, 69, 19, 0.1);
}

.player .stone {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 15rpx;
  border: 2rpx solid #333;
}

.player .stone.black {
  background: #1a1a1a;
}

.player .stone.white {
  background: #f5f5f5;
}

.vs {
  font-size: 28rpx;
  color: #999;
  margin: 0 30rpx;
  font-weight: bold;
}

/* 棋盘 */
.board-container {
  padding: 20rpx;
  background: #DEB887;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.15);
}

.board {
  position: relative;
  width: 700rpx;
  height: 700rpx;
  background: #F4A460;
  border-radius: 10rpx;
}

.grid-lines {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.grid-row {
  flex: 1;
  display: flex;
}

.grid-cell {
  flex: 1;
  border-right: 1rpx solid #8B4513;
  border-bottom: 1rpx solid #8B4513;
}

.grid-row:first-child .grid-cell {
  border-top: 1rpx solid #8B4513;
}

.grid-cell:first-child {
  border-left: 1rpx solid #8B4513;
}

/* 棋子 */
.stones {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.stone {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 2rpx 2rpx 6rpx rgba(0,0,0,0.3);
  transition: transform 0.2s;
}

.stone.black {
  background: radial-gradient(circle at 30% 30%, #444, #000);
}

.stone.white {
  background: radial-gradient(circle at 30% 30%, #fff, #ccc);
  border: 1rpx solid #999;
}

.stone.new {
  animation: placeStone 0.3s ease-out;
}

@keyframes placeStone {
  0% {
    transform: translate(-50%, -50%) scale(0);
  }
  70% {
    transform: translate(-50%, -50%) scale(1.1);
  }
  100% {
    transform: translate(-50%, -50%) scale(1);
  }
}

/* 点击区域 */
.click-area {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-wrap: wrap;
}

.click-cell {
  width: 6.666%;
  height: 6.666%;
}

/* 状态 */
.status {
  margin-top: 30rpx;
  font-size: 32rpx;
  color: #666;
  font-weight: 500;
}

.status .winner {
  color: #e74c3c;
  font-size: 40rpx;
  font-weight: bold;
}

/* 按钮 */
.buttons {
  display: flex;
  margin-top: 40rpx;
  gap: 20rpx;
}

.btn {
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border-radius: 10rpx;
  border: none;
  font-weight: 500;
}

.btn-primary {
  background: #8B4513;
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: #8B4513;
  border: 2rpx solid #8B4513;
}

.btn[disabled] {
  opacity: 0.5;
}